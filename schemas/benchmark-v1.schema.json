{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cudaverse.github.io/schemas/benchmark-v1.schema.json",
  "title": "cudaverse benchmark evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_status",
    "benchmark_id",
    "recorded_at",
    "sources",
    "environment",
    "workload",
    "correctness",
    "timing",
    "measurements",
    "claims"
  ],
  "properties": {
    "schema_version": { "const": "cudaverse-benchmark/1" },
    "evidence_status": { "enum": ["example", "measured"] },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "recorded_at": { "type": "string", "format": "date-time" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "commit", "dirty"],
        "properties": {
          "repository": {
            "type": "string",
            "pattern": "^cudaverse/[A-Za-z0-9._-]+$"
          },
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          },
          "dirty": { "type": "boolean" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hardware_label",
        "os",
        "architecture",
        "cpu",
        "memory_bytes",
        "gpu",
        "software"
      ],
      "properties": {
        "hardware_label": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "logical_cores"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "logical_cores": { "type": "integer", "minimum": 1 }
          }
        },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "count", "memory_bytes"],
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "count": { "type": "integer", "minimum": 1 },
            "memory_bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "r_version",
            "cuda_driver",
            "cuda_runtime",
            "package_versions"
          ],
          "properties": {
            "r_version": { "type": "string", "minLength": 1 },
            "cuda_driver": { "type": "string", "minLength": 1 },
            "cuda_runtime": { "type": "string", "minLength": 1 },
            "package_versions": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "seed",
        "dtype",
        "dimensions",
        "parameters"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "category": {
          "enum": ["dense", "sparse", "learning", "single-cell", "graph", "embedding"]
        },
        "seed": { "type": "integer" },
        "dtype": { "type": "string", "minLength": 1 },
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "sparsity": { "type": "number", "minimum": 0, "maximum": 1 },
        "parameters": { "type": "object" }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "reference_backend",
        "comparison",
        "tolerance",
        "max_abs_error"
      ],
      "properties": {
        "passed": { "const": true },
        "reference_backend": { "type": "string", "minLength": 1 },
        "comparison": { "type": "string", "minLength": 1 },
        "tolerance": { "type": "number", "minimum": 0 },
        "max_abs_error": { "type": "number", "minimum": 0 }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "warmup_iterations",
        "measured_iterations",
        "cuda_synchronized",
        "transfer_policy"
      ],
      "properties": {
        "clock": { "const": "elapsed_wall" },
        "warmup_iterations": { "type": "integer", "minimum": 1 },
        "measured_iterations": { "type": "integer", "minimum": 3 },
        "cuda_synchronized": { "const": true },
        "transfer_policy": {
          "enum": ["included", "excluded", "separate", "not_applicable"]
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "implementation",
          "device",
          "metric",
          "unit",
          "values",
          "summary"
        ],
        "properties": {
          "implementation": { "type": "string", "minLength": 1 },
          "device": { "enum": ["cpu", "cuda", "hybrid"] },
          "metric": {
            "enum": ["elapsed_seconds", "throughput", "peak_memory_bytes"]
          },
          "unit": { "type": "string", "minLength": 1 },
          "values": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0 }
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "required": ["count", "minimum", "median", "maximum"],
            "properties": {
              "count": { "type": "integer", "minimum": 1 },
              "minimum": { "type": "number", "minimum": 0 },
              "median": { "type": "number", "minimum": 0 },
              "maximum": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publication_ready", "scope", "break_even"],
      "properties": {
        "publication_ready": { "type": "boolean" },
        "scope": { "type": "string", "minLength": 1 },
        "break_even": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1 }
          ]
        }
      }
    }
  }
}
